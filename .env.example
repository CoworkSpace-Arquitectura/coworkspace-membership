# Copia este archivo como .env y cambia los valores. Nunca subas el .env al repositorio.

# Base de datos PostgreSQL del servicio (en producción: Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coworkspace_membership

# Puerto HTTP
PORT=3002

# Bus de eventos (en producción: Upstash Redis)
REDIS_URL=redis://localhost:6379

# Correo que se registra como jefe (OWNER)
OWNER_EMAIL=jefe@ejemplo.com
